# Copia este archivo a .env y rellena los secretos antes de levantar Docker Compose.
MAKOCLAW_WEB_PASSWORD=changeme
MAKOCLAW_PROVIDERS_ZHIPU_API_KEY=
MAKOCLAW_PROVIDERS_ZHIPU_API_BASE=https://api.z.ai/api/coding/paas/v4
MAKOCLAW_WEB_ENABLED=true
MAKOCLAW_AGENTS_DEFAULTS_PROVIDER=zhipu
MAKOCLAW_AGENTS_DEFAULTS_MODEL=glm-4-9
MAKOCLAW_AGENTS_DEFAULTS_RESTRICT_TO_WORKSPACE=true

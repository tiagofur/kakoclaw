# MakoClaw Environment Variables

# Providers
MAKOCLAW_PROVIDERS_ZHIPU_API_KEY=your_key_here

# Web Interface
MAKOCLAW_WEB_PASSWORD=admin

# Email Tools (Optional)
MAKOCLAW_TOOLS_EMAIL_ENABLED=true
MAKOCLAW_TOOLS_EMAIL_HOST=smtp.gmail.com
MAKOCLAW_TOOLS_EMAIL_PORT=587
MAKOCLAW_TOOLS_EMAIL_USERNAME=your_email@gmail.com
MAKOCLAW_TOOLS_EMAIL_PASSWORD=your_app_password
MAKOCLAW_TOOLS_EMAIL_FROM=MakoClaw <your_email@gmail.com>
MAKOCLAW_TOOLS_EMAIL_TO=recipient@example.com

# MCP Services
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
CONTEXT7_API_KEY=your_context7_api_key_here (optional)


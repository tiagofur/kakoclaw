# =============================================================================
# MakoClaw Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control - it contains sensitive data

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port binding for production
# Examples:
#   - "127.0.0.1:18880" (localhost only, use with reverse proxy)
#   - "0.0.0.0:18880" (all interfaces, direct access)
#   - "18880:18880" (Docker will choose interface)
MAKOCLAW_PORT=127.0.0.1:18880

# Data directory path (for production with bind mount)
MAKOCLAW_DATA_PATH=./MakoClaw-data

# Timezone (use your local timezone)
TZ=UTC

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# REQUIRED: Set a strong password for web access
# Generate a strong password with: openssl rand -base64 32
MAKOCLAW_WEB_PASSWORD=changeme_use_strong_password_here

# Web username (default: admin)
MAKOCLAW_WEB_USERNAME=admin

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Choose ONE provider and configure its settings below

# Provider name (required)
# Options: openrouter, anthropic, openai, groq, ollama, zhipu, gemini, nvidia, moonshot, vllm
MAKOCLAW_AGENTS_DEFAULTS_PROVIDER=openrouter

# Model to use (required, varies by provider)
# Examples:
#   - OpenRouter: anthropic/claude-3.5-sonnet, google/gemini-pro
#   - Anthropic: claude-3-sonnet-20240229
#   - OpenAI: gpt-4-turbo-preview
#   - Groq: llama2-70b-4096
#   - Ollama: llama3, mistral (local models)
MAKOCLAW_AGENTS_DEFAULTS_MODEL=anthropic/claude-3.5-sonnet

# -----------------------------------------------------------------------------
# Provider API Keys
# -----------------------------------------------------------------------------
# Uncomment and fill in the API key for your chosen provider

# OpenRouter (supports multiple models from different providers)
# Get key at: https://openrouter.ai/keys
MAKOCLAW_PROVIDERS_OPENROUTER_API_KEY=

# Anthropic (Claude models)
# Get key at: https://console.anthropic.com/
MAKOCLAW_PROVIDERS_ANTHROPIC_API_KEY=

# OpenAI (GPT models)
# Get key at: https://platform.openai.com/api-keys
MAKOCLAW_PROVIDERS_OPENAI_API_KEY=

# Groq (fast inference)
# Get key at: https://console.groq.com/keys
MAKOCLAW_PROVIDERS_GROQ_API_KEY=

# Ollama (self-hosted, local models)
# If running Ollama on the same machine:
#   - Use: http://host.docker.internal:11434 (from Docker)
#   - Or: http://localhost:11434 (if not using Docker)
MAKOCLAW_PROVIDERS_OLLAMA_API_BASE=

# Zhipu AI (Chinese provider)
MAKOCLAW_PROVIDERS_ZHIPU_API_KEY=

# Google Gemini
MAKOCLAW_PROVIDERS_GEMINI_API_KEY=

# Nvidia NIM
MAKOCLAW_PROVIDERS_NVIDIA_API_KEY=

# Moonshot AI (Chinese provider)
MAKOCLAW_PROVIDERS_MOONSHOT_API_KEY=

# -----------------------------------------------------------------------------
# Messaging Channels (Optional)
# -----------------------------------------------------------------------------

# Telegram Bot
MAKOCLAW_CHANNELS_TELEGRAM_ENABLED=false
MAKOCLAW_CHANNELS_TELEGRAM_TOKEN=
# Comma-separated list of allowed Telegram user IDs
MAKOCLAW_CHANNELS_TELEGRAM_ALLOW_FROM=

# Discord Bot
MAKOCLAW_CHANNELS_DISCORD_ENABLED=false
MAKOCLAW_CHANNELS_DISCORD_TOKEN=
# Comma-separated list of allowed Discord user IDs
MAKOCLAW_CHANNELS_DISCORD_ALLOW_FROM=

# Slack Bot
MAKOCLAW_CHANNELS_SLACK_ENABLED=false
MAKOCLAW_CHANNELS_SLACK_TOKEN=
MAKOCLAW_CHANNELS_SLACK_APP_TOKEN=
MAKOCLAW_CHANNELS_SLACK_ALLOW_FROM=

# WhatsApp (via bridge)
MAKOCLAW_CHANNELS_WHATSAPP_ENABLED=false
MAKOCLAW_CHANNELS_WHATSAPP_BRIDGE_URL=

# Signal (via CLI)
MAKOCLAW_CHANNELS_SIGNAL_ENABLED=false
MAKOCLAW_CHANNELS_SIGNAL_NUMBER=

# QQ Bot
MAKOCLAW_CHANNELS_QQ_ENABLED=false
MAKOCLAW_CHANNELS_QQ_APP_ID=
MAKOCLAW_CHANNELS_QQ_TOKEN=

# DingTalk Bot
MAKOCLAW_CHANNELS_DINGTALK_ENABLED=false
MAKOCLAW_CHANNELS_DINGTALK_APP_KEY=
MAKOCLAW_CHANNELS_DINGTALK_APP_SECRET=

# Feishu/Lark Bot
MAKOCLAW_CHANNELS_FEISHU_ENABLED=false
MAKOCLAW_CHANNELS_FEISHU_APP_ID=
MAKOCLAW_CHANNELS_FEISHU_APP_SECRET=

# MaixCam (custom protocol)
MAKOCLAW_CHANNELS_MAIXCAM_ENABLED=false
MAKOCLAW_CHANNELS_MAIXCAM_PORT=8889

# -----------------------------------------------------------------------------
# Email Tool (Optional)
# -----------------------------------------------------------------------------

MAKOCLAW_TOOLS_EMAIL_ENABLED=false
MAKOCLAW_TOOLS_EMAIL_HOST=smtp.gmail.com
MAKOCLAW_TOOLS_EMAIL_PORT=587
MAKOCLAW_TOOLS_EMAIL_USERNAME=
MAKOCLAW_TOOLS_EMAIL_PASSWORD=
# Default sender address
MAKOCLAW_TOOLS_EMAIL_FROM=
# Default recipient (can be overridden by agent)
MAKOCLAW_TOOLS_EMAIL_TO=

# -----------------------------------------------------------------------------
# Advanced Configuration
# -----------------------------------------------------------------------------

# Restrict agent file operations to workspace directory (recommended: true)
MAKOCLAW_AGENTS_DEFAULTS_RESTRICT_TO_WORKSPACE=true

# Maximum conversation history tokens (default: 100000)
MAKOCLAW_AGENTS_DEFAULTS_MAX_HISTORY_TOKENS=100000

# Maximum messages in history (default: 50)
MAKOCLAW_AGENTS_DEFAULTS_MAX_MESSAGES=50

# Tool execution timeout in seconds (default: 300)
MAKOCLAW_AGENTS_DEFAULTS_TOOL_TIMEOUT=300

# Enable verbose logging (default: false)
MAKOCLAW_AGENTS_DEFAULTS_VERBOSE=false

# Storage database path (auto-configured in Docker)
# MAKOCLAW_STORAGE_PATH=/home/makoclaw/.MakoClaw/MakoClaw.db

# -----------------------------------------------------------------------------
# Development Settings (not needed for production)
# -----------------------------------------------------------------------------

# Enable web UI debug mode
# MAKOCLAW_WEB_DEBUG=false

# CORS allowed origins (comma-separated)
# MAKOCLAW_WEB_CORS_ORIGINS=http://localhost:3000

# Gateway mode (enables all channels)
# MAKOCLAW_GATEWAY_ENABLED=false

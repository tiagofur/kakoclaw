ur fleet.\r\n        </p>\r\n\r\n        <Transition name=\"fade-slide\">\r\n          <div\n            v-if=\"orchestratorConfig.enabled\"\n            class=\"space-y-5 pt-5 border-t border-makoclaw-border/30\"\n          >\r\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\r\n              <div class=\"space-y-2\">\r\n                <label class=\"text-[10px] font-medium uppercase tracking-wide text-makoclaw-text-secondary/60 ml-1\">Command Provider</label>\r\n                <select\n                  v-model=\"orchestratorConfig.provider\"\n                  class=\"w-full bg-makoclaw-bg/40 border border-makoclaw-border/50 rounded-xl px-4 py-2.5 text-sm font-medium text-makoclaw-text focus:border-makoclaw-accent outline-none transition-all cursor-pointer\"\n                >\r\n                  <option\n                    v-for=\"p in configuredProviders\"\n                    :key=\"p.name\"\n                    :value=\"p.name\"\n                  >\n                    {{ p.name.toUpperCase() }}\n                  </option>\r\n                </select>\r\n              </div>\r\n              <div class=\"space-y-2\">\r\n                <label class=\"text-[10px] font-medium uppercase tracking-wide text-makoclaw-text-secondary/60 ml-1\">Primary Model Core</label>\r\n                <select\n                  v-model=\"orchestratorConfig.model\"\n                  class=\"w-full bg-makoclaw-bg/40 border-2 border-makoclaw-border/50 rounded-2xl px-5 py-3.5 text-sm font-bold text-makoclaw-accent focus:border-makoclaw-accent outline-none transition-all cursor-pointer\"\n                >\r\n                  <optgroup\n                    v-for=\"p in configuredProviders\"\n                    :key=\"p.name\"\n                    :label=\"p.name.toUpperCase()\"\n                  >\r\n                    <option\n                      v-for=\"m in p.models\"\n                      :key=\"m.id\"\n                      :value=\"m.id\"\n                    >\n                      {{ m.id }}\n                    </option>\r\n                  </optgroup>\r\n                </select>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\r\n              <div class=\"space-y-2\">\r\n                <label class=\"text-[10px] font-medium uppercase tracking-wide text-makoclaw-text-secondary/60 ml-1\">Cognitive Limit</label>\r\n                <input\n                  v-model.number=\"orchestratorConfig.max_tokens\"\n                  type=\"number\"\n                  class=\"w-full bg-makoclaw-bg/20 border border-makoclaw-border/30 rounded-xl px-4 py-2.5 text-sm font-medium text-makoclaw-text focus:border-makoclaw-accent outline-none transition-all\"\n                >\r\n              </div>\r\n              <div class=\"space-y-2\">\r\n                <label class=\"text-[10px] font-medium uppercase tracking-wide text-makoclaw-text-secondary/60 ml-1\">Entropy (Temp)</label>\r\n                <input\n                  v-model.number=\"orchestratorConfig.temperature\"\n                  type=\"number\"\n                  step=\"0.1\"\n                  min=\"0\"\n                  max=\"2\"\n                  class=\"w-full bg-makoclaw-bg/20 border border-makoclaw-border/30 rounded-xl px-4 py-2.5 text-sm font-medium text-makoclaw-text focus:border-makoclaw-accent outline-none transition-all\"\n                >\r\n              </div>\r\n              <div class=\"space-y-2\">\r\n                <label class=\"text-[10px] font-medium uppercase tracking-wide text-makoclaw-text-secondary/60 ml-1\">Recursion Depth</label>\r\n                <input\n                  v-model.number=\"orchestratorConfig.max_delegation_retries\"\n                  type=\"number\"\n                  class=\"w-full bg-makoclaw-bg/20 border border-makoclaw-border/30 rounded-xl px-4 py-2.5 text-sm font-medium text-makoclaw-text focus:border-makoclaw-accent outline-none